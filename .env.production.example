# Production env for docker-compose.prod.yml. Copy to `.env` on the VPS and fill
# in. NEVER commit the real .env. Generate secrets with: openssl rand -hex 32

# --- Caddy / domain ---
# DNS A-record for this must point at the VPS. Caddy auto-provisions TLS.
API_DOMAIN=api.yourdomain.com

# --- Application ---
APP_ENV=production
APP_NAME=FastForge
APP_DEBUG=false
APP_SECRET_KEY=

# --- Logging (structured JSON in prod) ---
LOG_SERVICE_NAME=api
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_ENABLE_CONSOLE=true

# --- Database (Supabase — use the pooler URL, sslmode=require) ---
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_SSL_MODE=require

# --- Cache (Redis runs as a service in docker-compose.prod.yml) ---
# "redis" is not optional in production: rate limiting, JWT revocation and
# per-API-key limits all read through the cache. Leaving this at "memory" gives
# each worker its own counters and wipes them on restart.
# The host is the compose service name, not localhost.
CACHE_PROVIDER=redis
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Single-use email tokens (verification, password reset) ---
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --- Email links / CORS: the deployed web app (Vercel) ---
FRONTEND_BASE_URL=https://app.yourdomain.com

# --- Mail (real provider in prod, e.g. Resend/Postmark SMTP) ---
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_USE_TLS=true
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=FastForge
MAIL_PRODUCT_NAME=FastForge
MAIL_SUPPORT_EMAIL=support@yourdomain.com

# --- Stripe (live keys for production) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- OAuth (Google & GitHub sign-in) ---
# Blank disables that provider — the API still boots, but
# /auth/{google,github}/login returns 503. Register these redirect URIs with
# each provider, using the real API domain above:
#   https://${API_DOMAIN}/api/v1/auth/google/callback
#   https://${API_DOMAIN}/api/v1/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Admin panel ---
# Comma-separated emails allowed into /api/v1/admin/*. Empty means nobody —
# the panel stays locked, which is the safe default if you leave it blank.
# Listed accounts must have a verified email to get in.
ADMIN_EMAILS=

# --- Monitoring (optional; blank disables) ---
SENTRY_DSN=
POSTHOG_API_KEY=

# --- Runtime tuning (1 vCPU box: 2 workers is a good default) ---
WEB_CONCURRENCY=2

# PERF: pre_ping costs one `SELECT 1` round-trip per request. Worth turning off
# when the VPS and Supabase are far apart (e.g. box in the EU, DB in the US);
# pool_recycle keeps connections fresh without it.
# DATABASE_POOL_PRE_PING=false
