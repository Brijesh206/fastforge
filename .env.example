# Application
# In production set APP_ENV=production — the app then refuses to start with
# APP_DEBUG=true or placeholder/short secrets, and hides /docs.
APP_ENV=development
APP_NAME=FastForge
APP_DEBUG=true
# Generate real values with: openssl rand -hex 32
APP_SECRET_KEY=change-me-in-production

# Logging
LOG_SERVICE_NAME=api
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_ENABLE_CONSOLE=true

# Database (local Docker PostgreSQL)
# PERF: develop against local Postgres (`docker compose up -d postgres`). Every
# query is <1ms here vs ~330ms against a US-hosted Supabase from India — the
# single biggest lever for dev API responsiveness. Only point at Supabase when
# you specifically need its data/behaviour.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastforge_platform
# Leave DATABASE_SSL_MODE unset for local (no SSL). An empty value fails
# validation — comment it out rather than assigning "". Set it (e.g. `require`)
# only for a remote DB like Supabase.
# DATABASE_SSL_MODE=require

# PERF: pre_ping adds one `SELECT 1` round-trip per request. Leave it on for a
# nearby/prod DB (negligible), turn it off when the DB is far away (a remote
# Supabase from another continent) to save that round-trip on every request.
# pool_recycle (default 1800s) keeps connections fresh without pre_ping.
# DATABASE_POOL_PRE_PING=false

# Database (Supabase PostgreSQL)
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Database (test)
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastforge_platform_test

# Cache (sessions, rate limiting, OTPs). "memory" needs no Redis running —
# the default so a fresh checkout works immediately. Switch to "redis" once
# Redis is available; required for anything that must be shared across
# workers or survive a restart (real rate limiting, real sessions).
CACHE_PROVIDER=memory
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Single-use email tokens (verification, password reset)
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Web app base URL that verification / reset email links point at.
FRONTEND_BASE_URL=http://localhost:3000

# Mail
# "console" logs emails instead of sending them (the default, and safe).
# "smtp" delivers for real — point it at Mailpit locally, a provider in production.
MAIL_PROVIDER=console
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_USE_TLS=false
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=FastForge
MAIL_REPLY_TO=
MAIL_PRODUCT_NAME=FastForge
MAIL_SUPPORT_EMAIL=support@localhost

# Storage (TODO: configure when storage package is implemented)
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=

# Stripe / Billing (use test-mode keys in development; blank disables billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The price ID of the plan checkout subscribes users to (price_...).
STRIPE_PRICE_ID=

# OAuth (TODO: configure when auth package is implemented)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Monitoring (TODO: configure for production)
SENTRY_DSN=
POSTHOG_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Admin panel — comma-separated emails allowed into /api/v1/admin/*.
# Empty means no admins (the panel is locked).
ADMIN_EMAILS=
