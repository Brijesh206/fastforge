# Keep the build context small and deterministic.
.git
.github
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache

# Virtualenvs / node / build output — regenerated inside the image, never
# copied in. A local .next especially must not leak into the web build.
.venv
**/.venv
node_modules
**/node_modules
**/.next
**/.turbo
**/*.tsbuildinfo

# Never ship secrets.
.env
**/.env
!*.env.example

# Local-only cruft.
docker-compose.yml
*.log
dist
build
.claude
.agents
.continue
.windsurf
